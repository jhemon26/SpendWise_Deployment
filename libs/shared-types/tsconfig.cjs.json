{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "isolatedModules": false,
    "outDir": "dist/cjs",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true
